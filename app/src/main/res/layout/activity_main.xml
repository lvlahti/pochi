<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#060606">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="23dp"
        android:paddingBottom="38dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:src="@drawable/pochi_brand_mark"
                android:contentDescription="Pochi logo" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POCHI"
                    android:letterSpacing="0.2"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SCREEN MIRROR"
                    android:letterSpacing="0.16"
                    android:textColor="#979797"
                    android:textSize="10sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/pochi_chip"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="v 0.7"
                android:textColor="#E9E9E9"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/pochi_hero"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="25dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.17"
                android:text="✦   YOUR SCREEN. REIMAGINED."
                android:textColor="#C3C3C3"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="A bigger view.\nA better flow."
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:lineSpacingExtra="3dp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Mirror beautifully over USB or Wi-Fi — straight to your browser. No receiver app needed."
                android:textColor="#B7B7B7"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/pochi_chip"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="◉  PRIVATE  /  LOCAL  /  LIVE"
                android:textColor="#E2E2E2"
                android:letterSpacing="0.08"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/connectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pochi_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="01    CONNECTION"
                android:textColor="#F4F4F4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pick how your devices talk."
                android:textColor="#969696"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/transportSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/pochi_glass_field"
                android:dropDownVerticalOffset="4dp"
                android:spinnerMode="dropdown" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="USB: enable tethering. Wi-Fi: join the same trusted network."
                android:textColor="#B3B3B3"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
            <Button
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/pochi_secondary_button"
                android:backgroundTint="@null"
                android:text="USB tethering settings    ↗"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pochi_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="02    VIDEO STUDIO"
                android:textColor="#F4F4F4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Fine-tune your stream, your way."
                android:textColor="#969696"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Encoding"
                android:textColor="#D2D2D2"
                android:textSize="13sp" />
            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pochi_glass_field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Maximum resolution"
                android:textColor="#D2D2D2"
                android:textSize="13sp" />
            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pochi_glass_field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Frame rate"
                android:textColor="#D2D2D2"
                android:textSize="13sp" />
            <Spinner
                android:id="@+id/fpsSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pochi_glass_field" />
            <TextView
                android:id="@+id/bitrateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="H.264 bitrate"
                android:textColor="#D2D2D2"
                android:textSize="13sp" />
            <Spinner
                android:id="@+id/bitrateSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pochi_glass_field" />
            <TextView
                android:id="@+id/qualityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="JPEG quality"
                android:textColor="#D2D2D2"
                android:textSize="13sp"
                android:visibility="gone" />
            <Spinner
                android:id="@+id/qualitySpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/pochi_glass_field"
                android:visibility="gone" />
            <CheckBox
                android:id="@+id/autoQualityCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="#FFFFFF"
                android:text="Auto Quality · reduce buffering"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Adaptive bitrate (H.264) or JPEG quality/FPS based on viewer backlog. Your selected values remain maximums."
                android:textColor="#A4A4A4"
                android:textSize="11sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Higher settings use more bandwidth and battery. Actual FPS depends on hardware."
                android:textColor="#979797"
                android:lineSpacingExtra="3dp"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/audioCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pochi_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="03    SOUND SPACE"
                android:textColor="#F4F4F4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <CheckBox
                android:id="@+id/audioCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#FFFFFF"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Share internal app audio"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Experimental · Android 10+ · Some apps restrict audio capture. The microphone is not streamed."
                android:textColor="#A3A3A3"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pochi_glass_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="04    LIVE CONTROL"
                android:textColor="#F4F4F4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="19dp"
                android:background="@drawable/pochi_primary_button"
                android:backgroundTint="@null"
                android:text="Start live    →"
                android:textAllCaps="false"
                android:textColor="#0A0A0A"
                android:textSize="15sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/pochi_stop_button"
                android:backgroundTint="@null"
                android:enabled="false"
                android:visibility="gone"
                android:text="Stop live"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/pochi_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">
                <TextView
                    android:id="@+id/statusIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#B9B9B9"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:text="Not sharing"
                    android:textColor="#DCDCDC"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/liveStatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#D3D3D3"
                android:textSize="12sp"
                android:visibility="gone"
                android:lineSpacingExtra="4dp"
                android:text="FPS —  ·  kbps —  ·  viewers —" />
            <LinearLayout
                android:id="@+id/shareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pochi_share_link_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="YOUR PRIVATE VIEWER LINK"
                    android:textColor="#DDDDDD"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/urlText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:autoLink="web"
                    android:breakStrategy="high_quality"
                    android:textColor="#FFFFFF"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="SCAN TO CONNECT"
                    android:textColor="#C9C9C9"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />
                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="#FFFFFF"
                    android:padding="7dp"
                    android:contentDescription="Scannable private session URL" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/copyLinkButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/pochi_secondary_button"
                        android:backgroundTint="@null"
                        android:text="Copy link"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/shareLinkButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/pochi_primary_button"
                        android:backgroundTint="@null"
                        android:text="Share    ↗"
                        android:textAllCaps="false"
                        android:textColor="#0A0A0A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Anyone with this link on your local network can view your screen while live."
                    android:textColor="#A6A6A6"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="Designed for your screen, not the cloud.\nOnly share on networks you trust."
                android:textColor="#969696"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/githubProfileLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pochi_chip"
                android:paddingLeft="19dp"
                android:paddingRight="19dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:gravity="center"
                android:text="GitHub   /   @lvlahti    ↗"
                android:textColor="#F6F6F6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open GitHub profile lvlahti" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>